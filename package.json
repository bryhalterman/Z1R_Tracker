{
  "name": "z1r-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Item and progress tracker for The Legend of Zelda (NES) and Zelda 1 Randomizer playthroughs.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @z1r/web",
    "dev:obs": "npm run dev --workspace @z1r/obs",
    "dev:desktop": "npm run dev --workspace @z1r/desktop",
    "build": "npm run build --workspace @z1r/web && npm run build --workspace @z1r/obs && npm run build --workspace @z1r/desktop",
    "build:web": "npm run build --workspace @z1r/web",
    "build:obs": "npm run build --workspace @z1r/obs",
    "build:desktop": "npm run build --workspace @z1r/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sprites:import": "node scripts/csv-to-manifest.mjs",
    "sprites:check": "node scripts/check-sprites.mjs",
    "test": "node scripts/test.mjs",
    "theme:check": "node scripts/theme-report.mjs",
    "serve:obs": "node scripts/serve.mjs",
    "start:obs": "npm run build:obs && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@spectrum-css/tokens": "^16.0.2",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
