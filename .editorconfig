# Editor defaults matching the repo: see .prettierrc.json and .gitattributes.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf

[*.sh]
end_of_line = lf
